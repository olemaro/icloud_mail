// iCloud Mail — application resources
#include <windows.h>

IDI_APP ICON "icloud_mail.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "iCloud Mail"
            VALUE "FileDescription",  "iCloud Mail — Native Windows Client"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "icloud_mail"
            VALUE "OriginalFilename", "icloud_mail.exe"
            VALUE "ProductName",      "iCloud Mail"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
